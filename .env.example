# Base de datos (SQLite en desarrollo). Producción: postgresql://usuario:clave@host:5432/db
DATABASE_URL="file:./dev.db"

# Secreto para firmar enlaces temporales de archivos. Genere uno con: openssl rand -hex 32
APP_SECRET="cambie-este-valor-por-uno-aleatorio-de-64-caracteres"

# URL pública (se usa en enlaces de invitación y correos)
APP_URL="http://localhost:3000"

# Nombre de la plataforma. Vacío = solo se muestra el logotipo de Redwood Capital Partners.
PLATFORM_NAME=""

# Datos de demostración: true muestra las oportunidades marcadas como DEMO en el catálogo.
SHOW_DEMO_DATA="true"

# Carpeta de archivos privados (fuera de /public).
STORAGE_DIR="./storage"

# --- Firma electrónica del NDA ---------------------------------------------
# none        = sin proveedor. Se registra la aceptación del NDA (nombre, fecha, IP, versión del texto),
#               claramente rotulada como «aceptación registrada», NO como firma electrónica.
# docusign | dropboxsign = requiere credenciales y el adaptador en src/lib/signature.ts
SIGNATURE_PROVIDER="none"
SIGNATURE_API_KEY=""
SIGNATURE_WEBHOOK_SECRET=""

# --- Correo transaccional ---------------------------------------------------
# none = los correos quedan en la bandeja de salida (Admin › Correos) y no se envían.
EMAIL_PROVIDER="none"
EMAIL_API_KEY=""
EMAIL_FROM="Redwood Capital Partners <no-responder@ejemplo.com>"

# --- Publicación en Vercel + Supabase ------------------------------------------
# En Vercel, DATABASE_URL es la cadena «Transaction pooler» de Supabase (puerto 6543)
# terminada en ?pgbouncer=true&connection_limit=1, y DIRECT_URL la «Session pooler» (puerto 5432).
# DIRECT_URL=""
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""          # secreta: solo en Vercel, nunca en el navegador
# SUPABASE_BUCKET="documentos-privados" # se crea privado automáticamente
# SEED_DEMO="true"                      # carga datos demo si la base está vacía
# APP_TIMEZONE="America/Mexico_City"
